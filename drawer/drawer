#!/usr/bin/env python3
import fcntl
import json
import os
import sys

CONFIG = os.path.expanduser("~/.config/omarchy/shell.json")
DRAWER = "local.drawer"
TRAYS = {"local.tray", "omarchy.tray"}
UNMANAGED = {DRAWER} | TRAYS


def entry_id(entry):
    return entry if isinstance(entry, str) else str(entry.get("id", ""))


def sync(drawer, right):
    hidden = drawer["hidden"]
    current = [e for e in right if entry_id(e) not in UNMANAGED]
    by_id = {entry_id(e): e for e in current}
    items = [by_id.get(entry_id(e), e) for e in drawer.get("items", [])]
    known = {entry_id(e) for e in items}
    items += [e for e in current if entry_id(e) not in known]

    ordered = [e for e in current if entry_id(e) not in hidden]
    slots = [i for i, e in enumerate(items) if entry_id(e) in by_id and entry_id(e) not in hidden]
    for slot, entry in zip(slots, ordered):
        items[slot] = entry
    drawer["items"] = items


def render(drawer, right):
    trays = [e for e in right if entry_id(e) in TRAYS]
    hidden = [e for e in drawer["items"] if entry_id(e) in drawer["hidden"]]
    shown = [e for e in drawer["items"] if entry_id(e) not in drawer["hidden"]]
    return [drawer] + hidden + trays + shown


def toggle_in(values, iid, other):
    if iid in values:
        values.remove(iid)
    else:
        values.append(iid)
        if iid in other:
            other.remove(iid)


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: drawer toggle|apply|pin <id>|hide <id>|tray-pin <id>|tray-hide <id>")
    action = sys.argv[1]

    with open(CONFIG, "r+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        config = json.load(handle)
        right = config["bar"]["layout"]["right"]
        drawer = next((e for e in right if isinstance(e, dict) and e.get("id") == DRAWER), None)
        if drawer is None:
            sys.exit("local.drawer is not in the right section")
        drawer.setdefault("pinned", [])
        drawer.setdefault("hidden", [])

        sync(drawer, right)
        tray = next((e for e in right if isinstance(e, dict) and e.get("id") in TRAYS), None)
        if action == "toggle":
            drawer["expanded"] = not drawer.get("expanded", True)
        elif action == "pin":
            toggle_in(drawer["pinned"], sys.argv[2], drawer["hidden"])
        elif action == "hide":
            toggle_in(drawer["hidden"], sys.argv[2], drawer["pinned"])
        elif action in ("tray-pin", "tray-hide"):
            if tray is None:
                sys.exit("no tray in the right section")
            tray.setdefault("pinned", [])
            tray.setdefault("hidden", [])
            first, second = ("pinned", "hidden") if action == "tray-pin" else ("hidden", "pinned")
            toggle_in(tray[first], sys.argv[2], tray[second])
        elif action != "apply":
            sys.exit("unknown action: " + action)
        if tray is not None:
            tray["drawerExpanded"] = drawer.get("expanded", True)
        if action == "apply":
            config["bar"]["layout"]["right"] = render(drawer, right)

        handle.seek(0)
        handle.truncate()
        handle.write(json.dumps(config, indent=2) + "\n")


main()
