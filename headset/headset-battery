#!/bin/bash
state=~/.local/state/headset
exec 9>"$XDG_RUNTIME_DIR/headset.lock"
flock 9
battery=$(headsetcontrol -b -o json 2>/dev/null | jq -c '
  .devices[0].battery
  | select(.status == "BATTERY_AVAILABLE" or .status == "BATTERY_CHARGING")')

if [[ -z $battery ]]; then
  rm -f "$state/online"
  exit 0
fi

mkdir -p "$state"
restore() { [[ ! -e $state/$1 ]] || headsetcontrol "$2" "$(<"$state/$1")" >/dev/null; }
if [[ ! -e $state/online ]] && restore light -l && restore sidetone -s; then
  touch "$state/online"
fi

echo "$battery"
